[Unit]
Description=Nexus Analytical Labs customer request app
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/nexus_analytical_labs
EnvironmentFile=-/etc/nexus-analytical-labs.env
ExecStart=/var/www/nexus_analytical_labs/.venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8010 wsgi:application
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
